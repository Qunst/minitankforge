{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MiniTankForge local server",
      "type": "shell",
      "command": ".vscode\\start-local-server.cmd",
      "isBackground": true,
      "problemMatcher": {
        "owner": "minitankforge",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "MiniTankForge local server",
          "endsPattern": "MiniTankForge local server running"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
